<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Android 11+ hides other apps unless they are named here: the hub must see the Craft apps
         to know which are installed and to open them. -->
    <queries>
        <package android:name="io.github.patrickdalton.craft.pdfcraft" />
        <package android:name="io.github.patrickdalton.craft.photocraft" />
        <package android:name="io.github.patrickdalton.craft.lightcraft" />
        <package android:name="io.github.patrickdalton.craft.filmcraft" />
        <package android:name="io.github.patrickdalton.craft.vectorcraft" />
        <package android:name="io.github.patrickdalton.craft.effectcraft" />
        <package android:name="io.github.patrickdalton.craft.designcraft" />
        <package android:name="io.github.patrickdalton.craft.figcraft" />
        <package android:name="io.github.patrickdalton.craft.wordcraft" />
        <package android:name="io.github.patrickdalton.craft.gridcraft" />
        <package android:name="io.github.patrickdalton.craft.deckcraft" />
        <package android:name="io.github.patrickdalton.craft.soundcraft" />
        <package android:name="io.github.patrickdalton.craft.cadcraft" />
    </queries>

    <application
        android:label="Craft Hub"
        android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
